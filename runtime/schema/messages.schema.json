{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halthinks.example/vibecut/runtime/schema/messages.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "VibeCut Runtime Protocol v1 Messages",
  "description": "Type-specific protocol messages. Every definition includes the common v1 envelope fields and a constrained payload.",
  "$defs": {
    "messageId": {"type": "string", "minLength": 1, "maxLength": 1024},
    "revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "base": {
      "type": "object",
      "required": ["v", "id", "kind", "type", "payload"],
      "properties": {
        "v": {"const": 1},
        "id": {"$ref": "#/$defs/messageId"},
        "kind": {"enum": ["request", "response", "event"]},
        "type": {"type": "string"},
        "payload": {"type": "object"}
      }
    },
    "hello": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "properties": {
            "type": {"const": "hello"},
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["editor_id", "adapter_id", "protocol_versions", "project_revision", "trust_mode", "tools"],
              "properties": {
                "editor_id": {"type": "string", "minLength": 1, "maxLength": 256},
                "adapter_id": {"type": "string", "minLength": 1, "maxLength": 256},
                "protocol_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
                "project_revision": {"$ref": "#/$defs/revision"},
                "trust_mode": {"enum": ["off", "auto", "turbo"]},
                "tools": {
                  "type": "array",
                  "maxItems": 10000,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["schema", "policy"],
                    "properties": {
                      "schema": {
                        "type": "object",
                        "required": ["name", "input_schema"],
                        "properties": {
                          "name": {"type": "string", "minLength": 1},
                          "description": {"type": "string"},
                          "input_schema": {"type": "object"}
                        }
                      },
                      "policy": {"$ref": "toolpolicy.schema.json"}
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "inspect": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "properties": {
            "type": {"const": "inspect"},
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "input"],
              "properties": {
                "operation": {"type": "string", "minLength": 1, "maxLength": 1024},
                "input": {"type": "object"}
              }
            }
          }
        }
      ]
    },
    "proposePlan": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "properties": {
            "type": {"const": "propose_plan"},
            "payload": {"$ref": "editplan.schema.json"}
          }
        }
      ]
    },
    "authorizeApproved": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "properties": {
            "type": {"const": "authorize"},
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["plan_id", "decision", "trust_mode", "authorization_id", "expected_revision", "approved_operation_ids"],
              "properties": {
                "plan_id": {"type": "string", "minLength": 1, "maxLength": 1024},
                "decision": {"const": "approved"},
                "trust_mode": {"enum": ["off", "auto", "turbo"]},
                "authorization_id": {"type": "string", "minLength": 1, "maxLength": 1024},
                "expected_revision": {"$ref": "#/$defs/revision"},
                "approved_operation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024}}
              }
            }
          }
        }
      ]
    },
    "authorizeRejected": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "properties": {
            "type": {"const": "authorize"},
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["plan_id", "decision", "trust_mode", "reason"],
              "properties": {
                "plan_id": {"type": "string", "minLength": 1, "maxLength": 1024},
                "decision": {"const": "rejected"},
                "trust_mode": {"enum": ["off", "auto", "turbo"]},
                "reason": {"type": "string", "minLength": 1, "maxLength": 16384}
              }
            }
          }
        }
      ]
    },
    "invoke": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "properties": {
            "type": {"const": "invoke"},
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["plan_id", "authorization_id", "operation_id", "expected_revision"],
              "properties": {
                "plan_id": {"type": "string", "minLength": 1, "maxLength": 1024},
                "authorization_id": {"type": "string", "minLength": 1, "maxLength": 1024},
                "operation_id": {"type": "string", "minLength": 1, "maxLength": 1024},
                "expected_revision": {"$ref": "#/$defs/revision"}
              }
            }
          }
        }
      ]
    },
    "verify": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "properties": {
            "type": {"const": "verify"},
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["plan_id", "authorization_id", "operation_id", "expected_revision", "expected_postconditions", "inspection"],
              "properties": {
                "plan_id": {"type": "string", "minLength": 1, "maxLength": 1024},
                "authorization_id": {"type": "string", "minLength": 1, "maxLength": 1024},
                "operation_id": {"type": "string", "minLength": 1, "maxLength": 1024},
                "expected_revision": {"$ref": "#/$defs/revision"},
                "expected_postconditions": {"type": "array", "maxItems": 1000, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
                "inspection": {"type": "string", "minLength": 1, "maxLength": 1024}
              }
            }
          }
        }
      ]
    },
    "jobUpdate": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "properties": {
            "type": {"const": "job_update"},
            "payload": {
              "type": "object",
              "required": ["job", "project_revision"],
              "properties": {
                "job": {"$ref": "job.schema.json"},
                "project_revision": {"$ref": "#/$defs/revision"}
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "revisionEvent": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "properties": {
            "type": {"const": "revision"},
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["project_revision", "reason"],
              "properties": {
                "project_revision": {"$ref": "#/$defs/revision"},
                "reason": {"type": "string", "minLength": 1, "maxLength": 4096}
              }
            }
          }
        }
      ]
    },
    "evidencePut": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "properties": {
            "type": {"const": "evidence_put"},
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["records"],
              "properties": {
                "records": {"type": "array", "maxItems": 100000, "items": {"$ref": "evidence.schema.json"}}
              }
            }
          }
        }
      ]
    },
    "evidenceGet": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "properties": {
            "type": {"const": "evidence_get"},
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source_id": {"type": "string", "minLength": 1},
                "source_fingerprint": {"type": "string", "minLength": 1},
                "extractor_id": {"type": "string", "minLength": 1},
                "extractor_version": {"type": "string", "minLength": 1},
                "kind": {"type": "string", "minLength": 1},
                "start_frame": {"type": "integer", "minimum": -1},
                "end_frame": {"type": "integer", "minimum": -1},
                "limit": {"type": "integer", "minimum": 1, "maximum": 10000}
              }
            }
          }
        }
      ]
    },
    "error": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "properties": {
            "type": {"const": "error"},
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message", "retryable", "details"],
              "properties": {
                "code": {"type": "string", "minLength": 1, "maxLength": 256},
                "message": {"type": "string", "minLength": 1, "maxLength": 16384},
                "retryable": {"type": "boolean"},
                "details": {"type": "object"}
              }
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/hello"},
    {"$ref": "#/$defs/inspect"},
    {"$ref": "#/$defs/proposePlan"},
    {"$ref": "#/$defs/authorizeApproved"},
    {"$ref": "#/$defs/authorizeRejected"},
    {"$ref": "#/$defs/invoke"},
    {"$ref": "#/$defs/verify"},
    {"$ref": "#/$defs/jobUpdate"},
    {"$ref": "#/$defs/revisionEvent"},
    {"$ref": "#/$defs/evidencePut"},
    {"$ref": "#/$defs/evidenceGet"},
    {"$ref": "#/$defs/error"}
  ]
}
